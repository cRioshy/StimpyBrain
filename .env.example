STIMPY_HYPOTHESIS_MIN_SUPPORTED_CASES=100
STIMPY_HYPOTHESIS_MIN_SUPPORTED_RATIO=0.70
STIMPY_HYPOTHESIS_MAX_CONTRADICTED_RATIO=0.30
