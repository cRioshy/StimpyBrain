# Safe Phase-2 defaults. Do not commit a real .env file.
STIMPY_ENABLED=true
STIMPY_MODE=observe
STIMPY_READ_ONLY=true
STIMPY_PANDORICK_ENABLED=false
STIMPY_PANDORICK_BASE_URL=http://127.0.0.1:8000
STIMPY_PANDORICK_POLL_INTERVAL_SECONDS=60
STIMPY_PANDORICK_REQUEST_TIMEOUT_SECONDS=5
STIMPY_PANDORICK_MAX_RETRIES=2
STIMPY_PANDORICK_BACKOFF_SECONDS=2
STIMPY_OBSERVATION_BATCH_LIMIT=100
STIMPY_MAX_PAYLOAD_BYTES=65536
STIMPY_DATA_DIR=stimpy_data
STIMPY_DATABASE_FILE=stimpy_data/database/stimpy_memory.sqlite3
STIMPY_JSONL_ROTATION_BYTES=134217728
STIMPY_MAX_FUTURE_SKEW_SECONDS=5
STIMPY_API_PORT=8765
